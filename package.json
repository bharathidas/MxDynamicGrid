{
    "name": "mxdynamicgrid-web",
    "widgetName": "MxDynamicGrid",
    "version": "1.0.0",
    "description": "A Mendix data grid whose columns are runtime data: end users add, rename, retype, reorder, pin, hide and delete typed columns (Airtable style) and edit rows, with Data Grid 2 and AG Grid features: filters, sorting, paging, selection, range selection with fill handle, paste from Excel, undo/redo, grouping with totals, record drawer, validation, saved views, styled Excel/CSV export and import. Writes changes through a JSON change set.",
    "copyright": "© MX Techies 2026",
    "license": "Apache-2.0",
    "private": true,
    "mxpackage": {
        "name": "MxDynamicGrid",
        "type": "widget",
        "mpkName": "com.mxtechies.widget.web.MxDynamicGrid.mpk"
    },
    "packagePath": "com.mxtechies.widget.web",
    "marketplace": {
        "minimumMXVersion": "11.0.0",
        "appName": "MxDynamicGrid"
    },
    "config": {
        "projectPath": "../../",
        "mendixHost": "http://localhost:8080",
        "developmentPort": 3000
    },
    "engines": {
        "node": "^22.18.0"
    },
    "scripts": {
        "build": "pluggable-widgets-tools build:ts",
        "dev": "pluggable-widgets-tools start:ts",
        "lint": "pluggable-widgets-tools lint",
        "lint:fix": "pluggable-widgets-tools lint:fix",
        "test": "jest --runInBand",
        "release": "pluggable-widgets-tools release:ts",
        "generate:typings": "node scripts/generate-typings.mjs",
        "harness": "node harness/build.mjs && node harness/test.mjs",
        "licenses": "node scripts/check-licenses.mjs",
        "icons": "node scripts/make-icons.mjs MxDynamicGrid src"
    },
    "dependencies": {
        "ag-grid-community": "36.1.0",
        "ag-grid-react": "36.1.0",
        "classnames": "^2.5.1",
        "fflate": "^0.8.3"
    },
    "devDependencies": {
        "@mendix/pluggable-widgets-tools": "11.12.1",
        "@types/big.js": "^6.2.2",
        "@types/jest": "^29.5.14",
        "esbuild": "^0.25.12",
        "jest": "^29.7.0",
        "puppeteer-core": "^24.43.1",
        "ts-jest": "^29.4.12"
    },
    "overrides": {
        "zip-a-folder": "6.1.4",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "@types/react": "19.0.0",
        "@types/react-dom": "19.0.0"
    },
    "resolutions": {
        "zip-a-folder": "6.1.4",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "@types/react": "19.0.0",
        "@types/react-dom": "19.0.0"
    },
    "keywords": [
        "mendix",
        "pluggable-widget",
        "dynamic-columns",
        "airtable",
        "data-grid",
        "ag-grid",
        "datagrid2",
        "spreadsheet",
        "excel-export",
        "no-code-table"
    ]
}
